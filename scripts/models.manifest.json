{
  "//": "What scripts/setup.ps1 downloads. Nothing here is a machine path.",
  "//2": "Files land in <data>/models and <data>/runtimes with these exact names, which match the default settings.",
  "schemaVersion": 1,
  "artifacts": [
    {
      "id": "brain",
      "kind": "huggingface",
      "repo": "Qwen/Qwen3-VL-4B-Instruct-GGUF",
      "filePattern": "*Q4_K_M*.gguf",
      "excludePattern": "*mmproj*",
      "targetName": "brain.gguf",
      "required": true,
      "note": "The thinking layer. Text + vision, about 2.5 GB at Q4_K_M."
    },
    {
      "id": "brain-vision",
      "kind": "huggingface",
      "repo": "Qwen/Qwen3-VL-4B-Instruct-GGUF",
      "filePattern": "*mmproj*.gguf",
      "excludePattern": "",
      "targetName": "brain-mmproj.gguf",
      "required": false,
      "note": "Vision projector. Without it she runs text-only."
    },
    {
      "id": "ears-parakeet",
      "kind": "url",
      "url": "https://huggingface.co/handy-computer/parakeet-unified-en-0.6b-gguf/resolve/main/parakeet-unified-en-0.6b-Q5_K_M.gguf",
      "sha256": "f9def6f9b4e83ab7d006df3e1b676dfa1f973a3b6da232a9c99fcaa66bcd2836",
      "targetName": "parakeet-unified-en-0.6b-Q5_K_M.gguf",
      "required": true,
      "note": "Production ears: NVIDIA Parakeet Unified EN 0.6B at Q5_K_M, 541 MB, English-only, CPU-only through transcribe.cpp. NVIDIA Open Model License, accepted by the owner."
    },
    {
      "id": "ears-transcribe-runtime",
      "kind": "github-release",
      "repo": "handy-computer/transcribe.cpp",
      "releaseTag": "v0.4.1",
      "assetPattern": "transcribe-native-0.4.1-windows-x86_64-cpu-vulkan.tar.gz",
      "fallbackAssetPattern": "transcribe-native-*windows-x86_64-cpu-vulkan.tar.gz",
      "sha256": "272eb97795048ccb557c85bb9dd44c9e530e1c928443114c39816a8a5f76269d",
      "targetName": "transcribe-native-windows-x86_64-cpu-vulkan",
      "sentinelFile": "transcribe.dll",
      "required": true,
      "note": "The transcribe.cpp C-API runtime the Parakeet ears live in. MIT licensed; ships GPU helper DLLs, but the adapter pins the backend registry to CPU so they are never loaded."
    },
    {
      "id": "runtime",
      "kind": "github-release",
      "repo": "ggml-org/llama.cpp",
      "assetPattern": "llama-*-bin-win-cuda-13.4-x64.zip",
      "fallbackAssetPattern": "llama-*-bin-win-vulkan-x64.zip",
      "targetName": "llama.cpp",
      "sentinelFile": "llama-server.exe",
      "required": true,
      "note": "llama-server, the process that hosts her brain. CUDA 13.4 for this machine; Vulkan build needs no CUDA DLLs at all."
    },
    {
      "id": "runtime-cuda",
      "kind": "github-release",
      "repo": "ggml-org/llama.cpp",
      "assetPattern": "cudart-llama-bin-win-cuda-13.4-x64.zip",
      "targetName": "llama.cpp",
      "sentinelFile": "cudart*.dll",
      "overlay": true,
      "required": false,
      "note": "CUDA runtime DLLs that go next to llama-server.exe. Merged as an overlay so it never replaces the binaries."
    },
    {
      "id": "pocket-uv",
      "kind": "github-release",
      "repo": "astral-sh/uv",
      "releaseTag": "0.13.5",
      "assetPattern": "uv-x86_64-pc-windows-msvc.zip",
      "sha256": "a38b8d1902b7cfbc76b423ba1bb456f623f42064cdc72628b6075b89afd1019a",
      "targetName": "pocket-uv",
      "sentinelFile": "uv.exe",
      "required": false,
      "note": "Pinned standalone installer for the isolated, CPU-only Pocket TTS runtime."
    }
  ]
}
