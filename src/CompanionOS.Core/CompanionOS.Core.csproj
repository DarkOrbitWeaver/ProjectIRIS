<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Core is everything that is not pixels: brain, memory, ears, eyes, hands and the
    module engine. It never references Avalonia, which is why she can boot headless for
    tests, run the ears while the window is closed, and be reused by any other front end.
  -->
  <PropertyGroup>
    <RootNamespace>CompanionOS.Core</RootNamespace>
    <AssemblyName>CompanionOS.Core</AssemblyName>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CompanionOS.Core.Tests" />

    <!-- Local database for the synaptic graph. SQLite is the one storage engine that
         survives a power cut mid-write, provided we keep WAL on. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />

    <!-- Audio in and out. WaveIn/WaveOut with no extra native dependencies. -->
    <PackageReference Include="NAudio" Version="2.2.1" />

    <!-- Screenshot encoding (Bitmap + JPEG). Windows-only by design, like the app. -->
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />

    <!-- Offline speech recognition on the CPU, in the ears tier, at 0 GB of VRAM. -->
    <PackageReference Include="Whisper.net" Version="1.7.0" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.7.0" />
  </ItemGroup>
</Project>

