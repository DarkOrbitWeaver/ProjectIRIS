{
  "manifest_version": 3,
  "name": "Iris Browser",
  "version": "0.1.0",
  "description": "Lets Iris read and act on the active tab, with a visible attention border.",
  "key": "",
  "permissions": ["storage", "tabs", "scripting", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Iris Browser", "default_popup": "popup.html" },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
